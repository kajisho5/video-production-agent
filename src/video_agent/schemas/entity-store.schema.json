{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "video-agent/entity-store@1",
 "title": "Entity memory store (ADR-128)",
 "description": "People and proper nouns of a workspace (global) or of one project / event: their canonical spelling, aliases and mis-hearings, type, lower-third title, pronunciation and speaker link. Human-editable; every write by the agent is validated against this schema.",
 "type": "object",
 "required": ["schema", "scope", "entities"],
 "additionalProperties": false,
 "if": {"properties": {"scope": {"const": "project"}}, "required": ["scope"]},
 "then": {"required": ["project"]},
 "else": {"not": {"required": ["project"]}},
 "properties": {
  "schema": {"const": "video-agent/entity-store@1"},
  "scope": {"enum": ["global", "project"]},
  "project": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
  "updated_at": {"type": "string"},
  "entities": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/entity"}}
 },
 "$defs": {
  "text": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$"},
  "entity": {
   "type": "object",
   "required": ["id", "canonical", "type"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "canonical": {"$ref": "#/$defs/text"},
    "type": {"enum": ["person", "organization", "product", "place", "term"]},
    "aliases": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/text"}},
    "title": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
    "pronunciation": {
     "type": "array", "maxItems": 10,
     "items": {
      "type": "object",
      "required": ["lang", "reading"],
      "additionalProperties": false,
      "properties": {
       "lang": {"type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
       "reading": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
       "ipa": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f\\[\\]()/]+$"},
       "accent": {"type": "integer", "minimum": 0, "maximum": 64}
      }
     }
    },
    "speaker": {
     "type": "object",
     "additionalProperties": false,
     "minProperties": 1,
     "properties": {
      "speaker_id": {"type": "string", "pattern": "^SPEAKER_\\d{2,}$"},
      "voiceprint": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
     }
    },
    "note": {"type": "string", "maxLength": 500},
    "added_at": {"type": "string"},
    "updated_at": {"type": "string"}
   }
  }
 }
}
