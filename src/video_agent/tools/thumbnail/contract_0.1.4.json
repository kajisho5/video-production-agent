    },
    "retryable": {
      "INVALID_REQUEST": false,
      "INVALID_INPUT": false,
      "PATH_NOT_ALLOWED": false,
      "UNSUPPORTED_OPERATION": false,
      "UNSUPPORTED_FORMAT": false,
      "MISSING_INPUT": false,
