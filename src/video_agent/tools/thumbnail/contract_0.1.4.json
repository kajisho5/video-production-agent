    }
  },
  "fonts": {
    "font_ids": [
      "cjk",
      "mono",
      "sans",
      "sans-bold",
      "serif"
    ],
    "resolution": "font_id -> the first existing file among this skill's registered per-platform candidate paths (fonts.py); never an arbitrary caller-supplied path; a font_id with no resolvable file fails MISSING_INPUT, never a silent substitution",
    "registry": {
      "sans": {
        "display_name": "Sans",
        "role": "default UI sans-serif"
      },
      "sans-bold": {
        "display_name": "Sans Bold",
        "role": "emphasis / headline sans-serif"
      },
      "serif": {
        "display_name": "Serif",
        "role": "serif text"
      },
      "mono": {
        "display_name": "Monospace",
        "role": "monospaced text"
      },
      "cjk": {
        "display_name": "CJK Sans",
        "role": "Japanese / Chinese / Korean text"
      }
    }
  },
  "rendering": {
    "engine": "Pillow",
    "video_frame_decoding": "delegated to ffmpeg-skill (probe, look --at --no-timecode); this skill never runs ffmpeg itself",
    "compositing": "Pillow raster operations only (paste/crop/resize/draw); no filter string, no shell, no arbitrary code path"
  },
  "execution": {
    "mode": "local",
    "canonical_invocation": [
      "thumbnail",
      "run",
      "-",
      "--json"
    ],
    "stdin": "{\"tool\": <tool_id>, \"params\": {...}}",
    "stdout": "exactly one thumbnail-skill/response@1 document (through run -) or {'ok', 'tool', 'result'}",
    "shell": false,
    "arbitrary_executables": false,
    "arbitrary_filters": false,
    "network": false,
    "input_mutation": false,
    "ai": false,
    "forbidden_request_fields": [
      "af",
      "args",
      "argv",
      "cmd",
      "command",
      "commands",
      "css",
      "cwd",
      "env",
      "eval",
      "exec",
      "executable",
      "ffmpeg",
      "filter",
      "filter_complex",
      "filters",
      "html",
      "javascript",
      "script",
      "shell",
      "vf"
    ]
  },
  "ffmpeg_skill": {
    "contract_version": "1.0",
    "tools_used": [
      "probe",
      "look"
    ],
    "compatibility": "any version whose probe/look expose flags_required (detected from its contract or --help; no version window)",
    "flags_required": {
      "probe": [],
      "look": [
        "output",
        "at",
        "no_timecode",
        "json"
      ]
    },
    "flags_optional": {
      "look": [
        "overwrite"
      ]
    }
  },
  "schema_versions": {
    "contract": "1",
    "request": "1",
    "response": "1",
    "doctor": "1"
  },
