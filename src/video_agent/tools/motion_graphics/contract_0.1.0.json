{
  "schema": "motion-graphics/contract@1",
  "skill_id": "motion-graphics",
  "id": "motion-graphics",
  "name": "motion-graphics-skill",
  "package": "motion-graphics-skill",
  "version": "0.1.0",
  "kind": "execution",
  "role": "motion graphics rendering (execution); not design, not decision",
  "description": "Deterministic motion-graphics rendering execution: title cards, lower thirds, free-form text overlays, image/logo overlays, and video-on-video picture-in-picture/chroma-key overlays, with built-in template animation (title/lower-third fade and slide) or a configurable linear fade (text/image overlays only); typed Graphics Document in, a validated video artifact with provenance out. Not an AI agent: it never chooses what to show, when to show it, or how it should look.",
  "repository": "https://github.com/kajisho5/motion-graphics-skill",
  "not_provided": [
    "AI reasoning",
    "design decisions",
    "production plans",
    "template or content selection",
    "arbitrary ffmpeg filters",
    "arbitrary shapes without a typed delegate tool",
    "position/scale animation (see unsupported_animations)",
    "video editing (video-editing-skill)",
    "color grading (color-grading-skill)",
    "subtitle generation (subtitle-skill)",
    "shell execution",
    "network access"
  ],
  "tools": [
    {
      "tool_id": "motion-graphics/run",
      "skill_id": "motion-graphics",
      "version": "0.1.0",
      "role": "execution",
      "description": "Render a typed Graphics Document (titles, lower thirds, text overlays, image/logo overlays, video-on-video picture-in-picture/chroma-key overlays, with fade animation) onto a video and write a validated artifact with provenance",
      "inputs": [
        "request document (stdin)"
      ],
      "input_type": "motion-graphics/request@1",
      "produces_output": true,
      "writes_media": true,
      "deterministic": true,
      "idempotency_hint": "content_equivalent; non-final intermediates reused by deterministic operation id",
      "element_types": [
        "bug",
        "chapter",
        "countdown",
        "image_overlay",
        "lower_third",
        "progress",
        "text_overlay",
        "title",
        "video_overlay"
      ],
      "supports": {
        "dry_run": true,
        "timeout": true,
        "cancel": true,
        "validate": true
      },
      "verification": "every artifact is probed (video stream, resolution, duration, sha256); the final output is always re-validated even when intermediates were reused",
      "provenance": "OBSERVED",
      "mutates_input": false,
      "delegates_to": [
        "ffmpeg-skill/probe",
        "ffmpeg-skill/graphics",
        "ffmpeg-skill/overlay"
      ]
    }
  ],
  "provides": [
    {
      "id": "motion_graphics.bug",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "motion-graphics/run",
      "element_type": "bug"
    },
    {
      "id": "motion_graphics.chapter",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "motion-graphics/run",
      "element_type": "chapter"
    },
    {
      "id": "motion_graphics.countdown",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "motion-graphics/run",
      "element_type": "countdown"
    },
    {
      "id": "motion_graphics.overlay",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "motion-graphics/run",
      "element_type": "image_overlay"
    },
    {
      "id": "motion_graphics.lower_third",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "motion-graphics/run",
      "element_type": "lower_third"
    },
    {
      "id": "motion_graphics.progress",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "motion-graphics/run",
      "element_type": "progress"
    },
    {
      "id": "motion_graphics.overlay",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "motion-graphics/run",
      "element_type": "text_overlay"
    },
    {
      "id": "motion_graphics.title_card",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "motion-graphics/run",
      "element_type": "title"
    },
    {
      "id": "motion_graphics.video_overlay",
      "lifecycle": "EXPERIMENTAL",
      "tool_id": "motion-graphics/run",
      "element_type": "video_overlay"
    }
  ],
  "element_types": [
    {
      "type": "title",
      "description": "Centered title card with an optional subtitle. Built-in 0.3s alpha fade in/out (ffmpeg-skill/graphics --template title); not configurable per element.",
      "tool": "ffmpeg-skill/graphics",
      "animation": "builtin_fade",
      "parameters": {
        "title": {
          "type": "string",
          "required": true,
          "max_length": 200
        },
        "subtitle": {
          "type": "string",
          "required": false,
          "max_length": 200
        },
        "text_color": {
          "type": "color",
          "required": false
        },
        "primary_color": {
          "type": "color",
          "required": false
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "filter:drawtext",
        "filter:drawbox",
        "encoder:libx264"
      ],
      "deterministic": "content_equivalent"
    },
    {
      "type": "lower_third",
      "description": "Name + title bar sliding in from the left. Built-in slide-in/out and fade (ffmpeg-skill/graphics --template lower-third); not configurable per element.",
      "tool": "ffmpeg-skill/graphics",
      "animation": "builtin_slide_fade",
      "parameters": {
        "name": {
          "type": "string",
          "required": true,
          "max_length": 200
        },
        "title": {
          "type": "string",
          "required": false,
          "max_length": 200
        },
        "text_color": {
          "type": "color",
          "required": false
        },
        "primary_color": {
          "type": "color",
          "required": false
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "filter:drawtext",
        "filter:overlay",
        "filter:color",
        "encoder:libx264"
      ],
      "deterministic": "content_equivalent"
    },
    {
      "type": "text_overlay",
      "description": "Free-form text drawn at a position, with an optional configurable fade in/out (ffmpeg-skill/overlay --text).",
      "tool": "ffmpeg-skill/overlay",
      "animation": "configurable",
      "parameters": {
        "text": {
          "type": "string",
          "required": true,
          "max_length": 500
        },
        "position": {
          "type": "position",
          "required": false,
          "default": "bottom"
        },
        "margin": {
          "type": "integer",
          "required": false,
          "min": 0,
          "max": 2000,
          "default": 24
        },
        "font": {
          "type": "font",
          "required": false
        },
        "font_size": {
          "type": "integer",
          "required": false,
          "min": 8,
          "max": 300,
          "default": 42
        },
        "font_color": {
          "type": "color",
          "required": false,
          "default": "white"
        },
        "border_width": {
          "type": "integer",
          "required": false,
          "min": 0,
          "max": 20,
          "default": 2
        },
        "border_color": {
          "type": "color",
          "required": false,
          "default": "black"
        },
        "box": {
          "type": "boolean",
          "required": false,
          "default": false
        },
        "box_color": {
          "type": "color",
          "required": false,
          "default": "black@0.5"
        },
        "opacity": {
          "type": "number",
          "required": false,
          "min": 0.0,
          "max": 1.0,
          "default": 1.0
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "filter:drawtext",
        "encoder:libx264"
      ],
      "deterministic": "content_equivalent"
    },
    {
      "type": "image_overlay",
      "description": "Composite a PNG/JPG image or logo at a position, with optional static scale and a configurable fade in/out (ffmpeg-skill/overlay --image).",
      "tool": "ffmpeg-skill/overlay",
      "animation": "configurable",
      "parameters": {
        "image_path": {
          "type": "path",
          "required": true
        },
        "position": {
          "type": "position",
          "required": false,
          "default": "top-right"
        },
        "margin": {
          "type": "integer",
          "required": false,
          "min": 0,
          "max": 2000,
          "default": 24
        },
        "scale_width": {
          "type": "integer",
          "required": false,
          "min": 1,
          "max": 8192
        },
        "scale_percent": {
          "type": "number",
          "required": false,
          "min": 0.1,
          "max": 100.0
        },
        "opacity": {
          "type": "number",
          "required": false,
          "min": 0.0,
          "max": 1.0,
          "default": 1.0
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "filter:overlay",
        "filter:scale",
        "filter:colorchannelmixer",
        "encoder:libx264"
      ],
      "deterministic": "content_equivalent"
    },
    {
      "type": "video_overlay",
      "description": "Composite a second video as a picture-in-picture layer at a position, with optional static scale, opacity, and chroma-key (green-screen) removal (ffmpeg-skill/overlay --video, --chromakey). Only this element's own audio track, if any, is dropped -- the base video's audio is unaffected, same as image_overlay/text_overlay.",
      "tool": "ffmpeg-skill/overlay",
      "animation": "none",
      "parameters": {
        "video_path": {
          "type": "path",
          "required": true
        },
        "position": {
          "type": "position",
          "required": false,
          "default": "bottom-right"
        },
        "margin": {
          "type": "integer",
          "required": false,
          "min": 0,
          "max": 2000,
          "default": 24
        },
        "scale_width": {
          "type": "integer",
          "required": false,
          "min": 1,
          "max": 8192
        },
        "scale_percent": {
          "type": "number",
          "required": false,
          "min": 0.1,
          "max": 100.0
        },
        "opacity": {
          "type": "number",
          "required": false,
          "min": 0.0,
          "max": 1.0,
          "default": 1.0
        },
        "chromakey": {
          "type": "color",
          "required": false
        },
        "chromakey_similarity": {
          "type": "number",
          "required": false,
          "min": 0.01,
          "max": 1.0,
          "default": 0.15
        },
        "chromakey_blend": {
          "type": "number",
          "required": false,
          "min": 0.0,
          "max": 1.0,
          "default": 0.05
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "filter:overlay",
        "filter:scale",
        "filter:colorchannelmixer",
        "filter:chromakey",
        "encoder:libx264"
      ],
      "deterministic": "content_equivalent"
    },
    {
      "type": "bug",
      "description": "Persistent text bug in a corner (e.g. \"@handle\" or \"LIVE\"). Built-in 0.3s alpha fade in/out (ffmpeg-skill/graphics --template bug); not configurable per element.",
      "tool": "ffmpeg-skill/graphics",
      "animation": "builtin_fade",
      "parameters": {
        "title": {
          "type": "string",
          "required": true,
          "max_length": 200
        },
        "position": {
          "type": "string",
          "required": false,
          "default": "top-right",
          "enum": [
            "top-left",
            "top-right",
            "bottom-left",
            "bottom-right"
          ]
        },
        "text_color": {
          "type": "color",
          "required": false
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "filter:drawtext",
        "encoder:libx264"
      ],
      "deterministic": "content_equivalent"
    },
    {
      "type": "chapter",
      "description": "Small chip in a corner (e.g. \"Part 2 -- Setup\"). Built-in 0.3s alpha fade in/out (ffmpeg-skill/graphics --template chapter); not configurable per element.",
      "tool": "ffmpeg-skill/graphics",
      "animation": "builtin_fade",
      "parameters": {
        "title": {
          "type": "string",
          "required": true,
          "max_length": 200
        },
        "position": {
          "type": "string",
          "required": false,
          "default": "bottom-left",
          "enum": [
            "top-left",
            "top-right",
            "bottom-left",
            "bottom-right"
          ]
        },
        "primary_color": {
          "type": "color",
          "required": false
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "filter:drawtext",
        "encoder:libx264"
      ],
      "deterministic": "content_equivalent"
    },
    {
      "type": "progress",
      "description": "Thin progress bar along the bottom of the frame that fills from empty to full over the element's own start/end window (ffmpeg-skill/graphics --template progress). No text, no position (always full-width along the bottom), and no fade -- it has none of its own to expose: the bar's fill is driven entirely by the element's timeline, not by an alpha.",
      "tool": "ffmpeg-skill/graphics",
      "animation": "none",
      "parameters": {
        "primary_color": {
          "type": "color",
          "required": false
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "filter:color",
        "filter:drawbox",
        "filter:overlay",
        "encoder:libx264"
      ],
      "deterministic": "content_equivalent"
    },
    {
      "type": "countdown",
      "description": "Big centered numbers counting down from count_from to 0, evenly spaced across the element's own start/end window, each with a brief built-in pulse (ffmpeg-skill/graphics --template countdown). No text, no position (always centered).",
      "tool": "ffmpeg-skill/graphics",
      "animation": "builtin_pulse",
      "parameters": {
        "count_from": {
          "type": "integer",
          "required": false,
          "default": 5,
          "min": 1,
          "max": 60
        },
        "primary_color": {
          "type": "color",
          "required": false
        }
      },
      "required_capabilities": [
        "ffmpeg-skill",
        "ffmpeg",
        "ffprobe",
        "filter:drawtext",
        "encoder:libx264"
      ],
      "deterministic": "content_equivalent"
    }
  ],
  "unsupported_element_types": [
    {
      "type": "shape",
      "status": "not_implemented",
      "reason": "no typed delegate tool draws an arbitrary shape (position/size/color) without a raw ffmpeg filter string; needs a typed shape tool in ffmpeg-skill first"
    }
  ],
  "animations": [
    {
      "kind": "fade",
      "description": "Linear alpha fade in at start and out at end, over the same duration (ffmpeg-skill/overlay --fade). Only for text_overlay and image_overlay.",
      "parameters": {
        "duration": {
          "type": "number",
          "required": true,
          "min": 0.01,
          "max": 30.0
        }
      },
      "applies_to": [
        "text_overlay",
        "image_overlay"
      ]
    }
  ],
  "unsupported_animations": [
    {
      "kind": "slide",
      "status": "not_implemented",
      "reason": "position animation is not exposed as a typed, per-element parameter by ffmpeg-skill/overlay; lower_third has a fixed, non-configurable built-in slide instead"
    },
    {
      "kind": "move",
      "status": "not_implemented",
      "reason": "arbitrary position keyframes would require a per-frame expression, which this skill does not construct (no raw filters, STEP 10)"
    },
    {
      "kind": "scale",
      "status": "not_implemented",
      "reason": "scale animation over time is not exposed as a typed parameter by ffmpeg-skill/overlay (static --scale / --scale-percent only)"
    },
    {
      "kind": "opacity_keyframes",
      "status": "not_implemented",
      "reason": "arbitrary opacity keyframe curves are not supported; use a fade (2-point in/out/in_out) instead"
    }
  ],
  "positions": {
    "named": [
      "top-left",
      "top",
      "top-right",
      "left",
      "center",
      "right",
      "bottom-left",
      "bottom",
      "bottom-right"
    ],
    "explicit": "{x: integer, y: integer} pixels; negative counts from the far edge (ffmpeg-skill/overlay semantics)"
  },
  "fonts": {
    "registry": {
      "system:dejavu-sans": "DejaVu Sans",
      "system:dejavu-serif": "DejaVu Serif",
      "system:dejavu-sans-mono": "DejaVu Sans Mono"
    },
    "default_font_id": "system:dejavu-sans",
    "custom_font_file": {
      "allowed_extensions": [
        ".ttf",
        ".otf",
        ".ttc"
      ],
      "path_policy": true,
      "provenance": "font_file_hash (sha256)"
    },
    "fallback_policy": "an unknown font_id or a missing font_file is MISSING_INPUT / INVALID_INPUT; this skill never substitutes a different font and reports success"
  },
  "output_formats": {
    "container": "same extension as document.output.path (ffmpeg-skill picks the codec for it)",
    "video_codec": "libx264",
    "audio_codec": "aac (passthrough of the source track's presence, not its codec)"
  },
  "limits": {
    "max_elements": 64,
    "max_element_duration_seconds": 86400.0
  },
  "timeline": {
    "unit": "seconds (float)",
    "ranges": "half-open-by-convention [start, end), start >= 0, end > start, both finite (no NaN/Infinity)",
    "element_ids": "unique within a document (id_pattern below), duplicates are DEPENDENCY_ERROR",
    "rendering_order": "elements are rendered in (start, id) order regardless of the order they were listed in the request (docs/decisions.md); each element's own start/end are rendered exactly as given",
    "duration_tolerance_seconds": 0.25
  },
  "execution": {
    "mode": "local",
    "canonical_invocation": [
      "motion-graphics",
      "run",
      "-",
      "--json"
    ],
    "stdin": "motion-graphics/request@1",
    "stdout": "exactly one motion-graphics/response@1 document",
    "stderr": "diagnostics only",
    "executables": [
      "python3 <ffmpeg-skill>/scripts/{probe,graphics,overlay}.py (argv lists)"
    ],
    "executable_resolution": "ffmpeg-skill directory: --ffmpeg-skill, MOTION_GRAPHICS_FFMPEG_SKILL_DIR, VIDEO_AGENT_FFMPEG_SKILL_DIR, ~/.claude/skills/ffmpeg-skill, ./vendor/ffmpeg-skill, ../ffmpeg-skill; ffmpeg/ffprobe: PATH lookup by ffmpeg-skill",
    "shell": false,
    "arbitrary_executables": false,
    "arbitrary_filters": false,
    "network": false,
    "input_mutation": false,
    "ai": false
  },
  "ffmpeg_skill": {
    "contract_version": "1.0",
    "version_window": {
      "min": "0.12.1",
      "max_exclusive": "1.0.0"
    },
    "tools_used": [
      "probe",
      "graphics",
      "overlay"
    ],
    "flags_used": {
      "probe": [
        "inputs"
      ],
      "graphics": [
        "input",
        "output",
        "template",
        "name",
        "title",
        "subtitle",
        "start",
        "end",
        "primary",
        "text_color",
        "font",
        "font_file",
        "audio_stream",
        "json"
      ],
      "overlay": [
        "input",
        "output",
        "image",
        "text",
        "video",
        "position",
        "margin",
        "start",
        "end",
        "fade",
        "opacity",
        "scale",
        "scale_percent",
        "font",
        "font_file",
        "font_size",
        "font_color",
        "border",
        "border_color",
        "box",
        "box_color",
        "chromakey",
        "chromakey_similarity",
        "chromakey_blend",
        "audio_stream",
        "json"
      ]
    }
  },
  "request": {
    "schema": "motion-graphics/request@1",
    "id_pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
    "forbidden_fields": [
      "af",
      "args",
      "argv",
      "cmd",
      "command",
      "commands",
      "cwd",
      "env",
      "eval",
      "exec",
      "executable",
      "expression",
      "filter",
      "filter_complex",
      "filters",
      "script",
      "shell",
      "vf"
    ],
    "shape": {
      "schema": "motion-graphics/request@1",
      "video": {
        "path": "file"
      },
      "output": {
        "path": "file",
        "overwrite?": false
      },
      "elements": [
        {
          "id": "id",
          "type": "bug|chapter|countdown|image_overlay|lower_third|progress|text_overlay|title|video_overlay",
          "start": 0,
          "end": 1,
          "parameters": {
            "...": "see element_types[].parameters"
          },
          "animation?": {
            "kind": "fade",
            "parameters": {
              "duration": 0.5
            }
          }
        }
      ],
      "options?": {
        "reuse_intermediates?": true,
        "crf?": 18,
        "preset?": "medium",
        "audio_stream?": 0
      }
    }
  },
  "response": {
    "schema": "motion-graphics/response@1",
    "success": {
      "run": {
        "ok": true,
        "status": "ok",
        "dry_run": false,
        "output": "{path, sha256, size, duration, width, height}",
        "timeline": "[{id, type, start, end}]",
        "operations": "[StageResult]",
        "reused": "bool",
        "engine": {},
        "provenance": {},
        "warnings": "[str] (e.g. a stage's dropped_non_av_streams surfaced as a warning; empty when there is nothing to report)"
      },
      "plan": {
        "ok": true,
        "status": "ok",
        "dry_run": true,
        "plan": "{document_id, video, output: {path}, timeline: [element + planned tool/asset/font]}",
        "note": "produced by `plan`, or `run --dry-run`; writes no media; has no output/operations/provenance keys"
      },
      "validate": {
        "ok": true,
        "status": "ok",
        "dry_run": true,
        "validation": "{ok: true, elements: [GraphicsElement, in render order]}",
        "note": "produced by `validate` only; structural check alone, no file-system access, no output/operations/plan keys"
      }
    },
    "failure": {
      "ok": false,
      "status": "error|cancelled",
      "error": {
        "code": "one of errors.codes",
        "message": "str",
        "retryable": "bool",
        "details": {}
      },
      "note": "the same failure shape for every command (validate/plan/run alike)"
    }
  },
  "provenance": {
    "per_operation": [
      "operation_id",
      "type",
      "tool",
      "status",
      "parameters",
      "input_hashes",
      "output_hash",
      "seconds",
      "tool_commands_observed",
      "dropped_non_av_streams (present, true, only when ffmpeg-skill's own subtitle/data-stream preservation fell back for that stage)"
    ],
    "per_output": [
      "document_id",
      "video (path, sha256, duration, width, height)",
      "assets (sha256 per element)",
      "fonts (font_id or font_file_hash per element)",
      "operations (chain)",
