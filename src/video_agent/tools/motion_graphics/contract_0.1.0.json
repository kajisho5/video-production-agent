    "cancel": true,
    "dry_run": true,
    "timeout": true,
    "validate": true
   },
   "tool_id": "motion-graphics/run",
   "verification": "every artifact is probed (video stream, resolution, duration, sha256); the final output is always re-validated even when intermediates were reused",
