  "unsupported_element_types": [
    {
      "type": "shape",
      "status": "not_implemented",
      "reason": "not implemented: a rectangle can be composed from ffmpeg-skill's background.py and overlay.py --video (docs/decisions.md ADR-8), but that is two tool calls for one element, which this skill's one-delegate-call-per-element stage model does not cover yet; it needs its own design decision, and building a raw ffmpeg filter string instead is not an option"
    }
  ],
  "animations": [
    {
      "kind": "fade",
      "description": "Linear alpha fade in at start and out at end, over the same duration (ffmpeg-skill/overlay --fade). Only for text_overlay and image_overlay.",
      "parameters": {
        "duration": {
          "type": "number",
          "required": true,
          "min": 0.01,
          "max": 30.0
        }
      },
      "applies_to": [
        "text_overlay",
        "image_overlay"
      ]
    }
  ],
  "unsupported_animations": [
    {
      "kind": "slide",
      "status": "not_implemented",
      "reason": "position animation is not exposed as a typed, per-element parameter by ffmpeg-skill/overlay; lower_third has a fixed, non-configurable built-in slide instead"
    },
    {
      "kind": "move",
      "status": "not_implemented",
      "reason": "arbitrary position keyframes would require a per-frame expression, which this skill does not construct (no raw filters, STEP 10)"
    },
    {
      "kind": "scale",
      "status": "not_implemented",
      "reason": "scale animation over time is not exposed as a typed parameter by ffmpeg-skill/overlay (static --scale / --scale-percent only)"
    },
    {
      "kind": "opacity_keyframes",
      "status": "not_implemented",
      "reason": "arbitrary opacity keyframe curves are not supported; use a fade (2-point in/out/in_out) instead"
    }
  ],
  "platforms": {
    "names": [
      "broadcast",
      "facebook",
      "instagram",
      "linkedin",
      "podcast",
      "reels",
      "shorts",
      "tiktok",
      "twitter",
      "youtube",
      "youtube-shorts"
    ],
    "request_field": "options.platform",
    "applies_to": "every graphics and overlay stage of the document (one destination per document)",
    "effect": "an element margin the request does not give explicitly becomes that destination's safe zone (ffmpeg-skill --platform, per edge: e.g. a top-left logo clears TikTok's status bar); a margin the request gives wins -- except that ffmpeg-skill/overlay treats a margin equal to its own default (24) as not given, so the safe zone still applies to an explicit 24; explicit {x,y} positions are unaffected",
    "requires": "an ffmpeg-skill checkout whose graphics/overlay tools have --platform; otherwise the request is refused before rendering (TOOL_ERROR)"
  },
