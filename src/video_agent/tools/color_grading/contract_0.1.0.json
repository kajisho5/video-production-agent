 "operations": [
  {
   "changes_duration": false,
   "changes_resolution": false,
   "description": "Tone-map HDR (PQ/HLG, BT.2020) to SDR BT.709 (ffmpeg-skill/color --to-sdr)",
   "deterministic": "content_equivalent",
   "inputs": 1,
   "parameters": {
    "crf": {
     "default": 18,
     "description": "x264 constant rate factor (0=lossless, 51=worst); lower is higher quality / larger file",
     "max": 51,
     "min": 0,
     "required": false,
     "type": "integer"
    },
    "desat": {
     "default": 0.0,
     "description": "tonemap desaturation strength",
     "max": 5.0,
     "min": 0.0,
     "required": false,
     "type": "number"
    },
    "force": {
     "default": false,
     "description": "tone-map even if the source is not tagged HDR (treat as PQ)",
     "required": false,
     "type": "boolean"
    },
    "peak_nits": {
     "default": 1000.0,
     "description": "source peak brightness in nits, used for PQ",
     "max": 10000.0,
     "min": 1.0,
     "required": false,
     "type": "number"
    },
    "preset": {
     "default": "medium",
     "description": "x264 encoding speed/efficiency preset",
     "enum": [
      "ultrafast",
      "superfast",
      "veryfast",
      "faster",
      "fast",
      "medium",
      "slow",
      "slower",
      "veryslow",
      "placebo"
     ],
     "required": false,
     "type": "string"
    },
    "tonemap": {
     "default": "hable",
     "description": "tone-mapping curve",
     "enum": [
      "hable",
      "mobius",
      "reinhard",
      "bt2390",
      "clip",
      "linear",
      "gamma"
     ],
     "required": false,
     "type": "string"
    }
   },
   "required_capabilities": [
    "ffmpeg-skill",
    "ffmpeg",
    "ffprobe",
    "filter:zscale",
    "filter:tonemap",
    "encoder:libx264"
   ],
   "tool": "ffmpeg-skill/color",
   "type": "HDR_TO_SDR"
  },
  {
   "changes_duration": false,
   "changes_resolution": false,
   "description": "Apply a 3D .cube LUT (ffmpeg-skill/color --lut); LUT is data, resolved and hashed by this skill, never a filter string",
   "deterministic": "content_equivalent",
   "inputs": 1,
   "parameters": {
    "crf": {
     "default": 18,
     "description": "x264 constant rate factor (0=lossless, 51=worst); lower is higher quality / larger file",
     "max": 51,
     "min": 0,
     "required": false,
     "type": "integer"
    },
    "lut_path": {
     "description": "path to a .cube LUT file, resolved through the LUT PathPolicy",
     "required": true,
     "type": "string"
    },
    "lut_strength": {
     "default": 1.0,
     "description": "blend of the LUT result with the original, 0..1 (ffmpeg-skill applies the LUT at full strength for both 0.0 and 1.0; only a value strictly between them blends, see docs/ffmpeg-skill.md)",
     "max": 1.0,
     "min": 0.0,
     "required": false,
     "type": "number"
    },
    "preset": {
     "default": "medium",
     "description": "x264 encoding speed/efficiency preset",
     "enum": [
      "ultrafast",
      "superfast",
      "veryfast",
      "faster",
      "fast",
      "medium",
      "slow",
      "slower",
      "veryslow",
      "placebo"
     ],
     "required": false,
     "type": "string"
    }
   },
   "required_capabilities": [
    "ffmpeg-skill",
    "ffmpeg",
    "ffprobe",
    "filter:lut3d",
    "encoder:libx264"
   ],
   "tool": "ffmpeg-skill/color",
   "type": "LUT_APPLY"
  },
  {
   "changes_duration": false,
   "changes_resolution": false,
   "description": "Rewrite colour tags only, no re-encode when the container allows it (ffmpeg-skill/color --retag)",
   "deterministic": "content_equivalent",
   "inputs": 1,
   "parameters": {
    "target": {
     "description": "colour tag set to write",
     "enum": [
      "bt709",
      "bt2020-pq",
      "bt2020-hlg",
      "bt601"
     ],
     "required": true,
     "type": "string"
    }
   },
   "required_capabilities": [
    "ffmpeg-skill",
    "ffmpeg",
    "ffprobe"
   ],
   "tool": "ffmpeg-skill/color",
   "type": "RETAG"
  },
  {
   "changes_duration": false,
   "changes_resolution": false,
   "description": "Remove the Dolby Vision RPU (profile 8.4 clips), keeping the HLG/HDR10 base layer; stream copy (ffmpeg-skill/color --strip-dovi)",
